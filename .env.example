# TARA — Environment Variables
# Copy this file to .env and fill in your API keys.

# Wajib — setidaknya satu provider LLM harus diisi
# OpenRouter (rekomendasi): satu key akses Claude, GPT, Gemini, DeepSeek & 200+ model
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Opsional
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info
